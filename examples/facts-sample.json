    },
    {
      "label": "com.sketchy.agent",
      "plist": "/Users/tester/Library/LaunchAgents/com.sketchy.agent.plist",
      "scope": "user-agent",
      "program": "/Users/tester/.local/bin/agent",
      "signature": { "valid": true, "notarized": false, "teamID": null }
    }
  ],
  "mdm.payloadTypes": [],
